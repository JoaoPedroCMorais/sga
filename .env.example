# ==============================================================================
# SGA v4.0 — Template de variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env preenchido.
# ==============================================================================

# ---------- Banco de dados ----------
# Dev: aponta para o PostgreSQL do docker-compose.yml
# Prod: fornecido pelo Railway
POSTGRES_USER=sga
POSTGRES_PASSWORD=
POSTGRES_DB=sga_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sga:CHANGE_ME@localhost:5432/sga_dev

# ---------- Aplicação ----------
ENVIRONMENT=development          # development | staging | production
DEBUG=true
SECRET_KEY=                      # gere com: openssl rand -hex 32
API_V1_PREFIX=/api/v1

# ---------- Autenticação (ADR-013) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
ALLOWED_EMAIL_DOMAIN=            # domínio institucional do CAAI
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false              # true em produção
COOKIE_SAMESITE=lax

# ---------- CORS ----------
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Storage (Fase 5) ----------
STORAGE_BACKEND=local            # local | s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Observabilidade ----------
SENTRY_DSN_API=
SENTRY_DSN_WEB=
